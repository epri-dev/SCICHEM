# @PACKAGE_INIT@
# set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "@PACKAGE_include_install_dir@")

# Client options from SCIPUFF build
set(scipuff_use_openmp @client_use_openmp@)
set(scipuff_options @client_options@)

# Location of any Find<lib>.cmake files that have been installed
set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${CMAKE_CURRENT_LIST_DIR}/modules")

include("${CMAKE_CURRENT_LIST_DIR}/@TARGETS_EXPORT_NAME@.cmake")
check_required_components("@PROJECT_NAME@")

include(FindPackageMessage)
find_package_message(@PROJECT_NAME@
  "Found @PROJECT_NAME@: ${@PROJECT_NAME@_DIR}"
  "[${@PROJECT_NAME@_DIR}]"
)